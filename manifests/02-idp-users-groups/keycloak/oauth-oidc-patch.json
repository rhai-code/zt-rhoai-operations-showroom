[
  {
    "op": "add",
    "path": "/spec/identityProviders/-",
    "value": {
      "name": "keycloak-oidc",
      "type": "OpenID",
      "mappingMethod": "claim",
      "openID": {
        "clientID": "openshift",
        "clientSecret": {
          "name": "keycloak-oidc-secret"
        },
        "issuer": "__KEYCLOAK_URL__/realms/master",
        "claims": {
          "preferredUsername": ["preferred_username"],
          "name": ["name"],
          "email": ["email"]
        }
      }
    }
  }
]
